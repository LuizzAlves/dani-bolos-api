# ============================================
# Dani Bolos — FastAPI Motor de Atendimento
# Variáveis de ambiente (template)
# ============================================
# Copie para .env e preencha com valores reais.
# ============================================

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://postgres:senha@localhost:5432/confeitaria_motor

# --- Evolution API ---
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_TOKEN=seu_token_aqui
EVOLUTION_INSTANCE_NAME=confeitaria
WEBHOOK_TOKEN=seu_token_secreto_para_webhook

# --- Google Sheets (painel operacional) ---
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/seu_id/exec
GOOGLE_SHEETS_WEBAPP_TOKEN=token_secreto_script
GOOGLE_SHEETS_TIMEOUT_SECONDS=10

# --- IA tradutora semântica (opcional) ---
AI_TRANSLATOR_ENABLED=false
GROQ_API_KEY=
GROQ_TRANSLATOR_MODEL=llama-3.1-8b-instant

# --- Configurações do Motor ---
MAX_FALLBACK_COUNT=3
HUMAN_LOCK_HOURS=4
DEFAULT_TIMEOUT_MINUTES=120

# --- Admin ---
ADMIN_TOKEN=trocar_por_token_seguro

# --- App ---
APP_ENV=development
LOG_LEVEL=DEBUG
